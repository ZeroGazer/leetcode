class Solution {
    public int uniqueXorTriplets(int[] nums) {
        Set<Integer> set = new HashSet<>();
        List<Integer> deduplicated = new ArrayList<>();
        int max = 0;
        for (int num : nums) {
            if (!set.contains(num)) {
                set.add(num);
                deduplicated.add(num);
                max = Math.max(max, num);
            }
        }
        max = Integer.highestOneBit(max) << 1;
        boolean[] two = new boolean[max], three = new boolean[max];
        for (int i = 0; i < deduplicated.size(); i++) {
            for (int j = i; j < deduplicated.size(); j++) {
                two[deduplicated.get(i) ^ deduplicated.get(j)] = true;
            }
        }
        for (int i = 0; i < deduplicated.size(); i++) {
            for (int j = 0; j < max; j++) {
                if (two[j]) {
                    three[deduplicated.get(i) ^ j] = true;
                }
            }
        }
        int count = 0;
        for (int i = 0; i < max; i++) {
            if (three[i]) {
                count++;
            }
        }
        return count;
    }
}