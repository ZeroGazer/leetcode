class Solution {
    public int minInsertions(String s) {
        int n = s.length(), open = 0, close = 0;
        for (int i = 0; i < n; i++) {
            if (s.charAt(i) == '(') {
                open++;
            } else {
                if (open > 0) {
                    open--;
                } else {
                    close++;
                }
                if (i + 1 < n && s.charAt(i + 1) == ')') {
                    i++;
                } else {
                    close++;
                }
            }
        }
        return open * 2 + close;
    }
}