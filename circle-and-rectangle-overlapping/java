class Solution {
    public boolean checkOverlap(int radius, int xCenter, int yCenter, int x1, int y1, int x2, int y2) {
        int a = 0, b = 0;
        if (xCenter < x1) {
            a = x1 - xCenter;
        } else if (xCenter > x2) {
            a = xCenter - x2;
        }
        if (yCenter < y1) {
            b = y1 - yCenter;
        } else if (yCenter > y2) {
            b = yCenter - y2;
        }
        return a * a + b * b <= radius * radius;
    }
}