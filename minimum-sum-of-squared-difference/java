class Solution {
    public long minSumSquareDiff(int[] nums1, int[] nums2, int k1, int k2) {
        int n = nums1.length;
        long sumDiff = 0, maxModify = k1 + k2;
        for (int i = 0; i < n; i++) {
            nums1[i] = Math.abs(nums1[i] - nums2[i]);
            sumDiff += nums1[i];
        }
        if (sumDiff <= maxModify) {
            return 0;
        }
        Arrays.sort(nums1);
        for (int i = 0; i < n ; i++) {
            long diff = (nums1[n - 1 - i] - (i == n - 1 ? 0 : nums1[n - 2 - i])) * (long) (i + 1);
            if (diff > maxModify) {
                long unmodified = i + 1 - maxModify % (i + 1), modified = maxModify % (i + 1);
                diff = nums1[n - 1 - i] - maxModify / (i + 1);
                long result = diff * diff * unmodified + (diff - 1) * (diff - 1) * modified;
                for (int j = i + 1; j < n; j++) {
                    result += (long) nums1[n - 1 - j] * nums1[n - 1 - j];
                }
                return result;
            }
            maxModify -= diff;
        }
        return 0;
    }
}