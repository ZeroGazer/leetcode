class Solution {
    public int stoneGameII(int[] piles) {
        int n = piles.length;
        int[] suffixSum = new int[n];
        suffixSum[n - 1] = piles[n - 1];
        for (int i = n - 2; i > -1; i--) {
            suffixSum[i] = suffixSum[i + 1] + piles[i];
        }
        return dp(suffixSum, 1, 0, new int[n][n], n);
    }

    private int dp(int[] suffixSum, int M, int index, int[][] memo, int n) {
        if (index + 2 * M >= n) {
            return suffixSum[index];
        }
        if (memo[M][index] > 0) {
            return memo[M][index];
        }
        int min = Integer.MAX_VALUE;
        for (int i = 1; i <= 2 * M; i++) {
            min = Math.min(min, dp(suffixSum, Math.max(i, M), index + i, memo, n));
        }
        return memo[M][index] = suffixSum[index] - min;
    }
}