class Solution {
    public long maxAlternatingSum(int[] nums) {
        int n = nums.length;
        for (int i = 0; i < n; i++) {
            nums[i] *= nums[i];
        }
        Arrays.sort(nums);
        long max = 0;
        for (int i = 0; i < n / 2; i++) {
            max += nums[n - 1 - i];
            max -= nums[i];
        }
        if ((n & 1) == 1) {
            max += nums[n / 2];
        }
        return max;
    }
}