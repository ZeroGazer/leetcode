class Solution {
    public int[] resultArray(int[] nums) {
        int n = nums.length, left = 0, right = n - 1;
        int[] result = new int[n];
        result[left] = nums[0];
        result[right] = nums[1];
        for (int i = 2; i < n; i++) {
            if (result[left] > result[right]) {
                result[++left] = nums[i];
            } else {
                result[--right] = nums[i];
            }
        }
        left = right;
        right = n - 1;
        while (left < right) {
            int temp = result[right];
            result[right--] = result[left];
            result[left++] = temp;
        }
        return result;
    }
}