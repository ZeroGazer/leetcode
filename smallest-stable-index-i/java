class Solution {
    public int firstStableIndex(int[] nums, int k) {
        int n = nums.length;
        int[] scores = new int[n];
        scores[n - 1] = nums[n - 1];
        for (int i = n - 2; i > -1; i--) {
            scores[i] = Math.min(scores[i + 1], nums[i]);
        }
        for (int i = 0, max = nums[0]; i < n; i++) {
            max = Math.max(max, nums[i]);
            scores[i] = max - scores[i];
            if (scores[i] <= k) {
                return i;
            }
        }
        return -1;
    }
}