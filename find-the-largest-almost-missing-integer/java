class Solution {
    public int largestInteger(int[] nums, int k) {
        int n = nums.length;
        if (k == n) {
            int max = 0;
            for (int num : nums) {
                max = Math.max(max, num);
            }
            return max;
        }
        int[]  freqs = new int[51];
        for (int num : nums) {
            freqs[num]++;
        }
        if (k == 1) {
            for (int i = 50; i > -1; i--) {
                if (freqs[i] == 1) {
                    return i;
                }
            }
            return -1;
        } else {
            int max = -1;
            if (freqs[nums[0]] == 1) {
                max = Math.max(max, nums[0]);
            }
            if (freqs[nums[n - 1]] == 1) {
                max = Math.max(max, nums[n - 1]);
            }
            return max;
        }
    }
}