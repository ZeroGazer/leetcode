class Solution {
    public int smallestNumber(int n, int t) {
        int result = n;
        while (result <= n + 9) {
            int product = 1;
            for (int i = result; i > 0; i /= 10) {
                product *= i % 10;
            }
            if (product % t == 0) {
                break;
            }
            result++;
        }
        return result;
    }
}