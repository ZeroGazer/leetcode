class Solution {
    public String licenseKeyFormatting(String s, int k) {
        int n = s.length(), length = 0;
        StringBuilder sb = new StringBuilder();
        for (int i = n - 1; i > -1; i--) {
            char c = s.charAt(i);
            if (c != '-') {
                if (length++ == k) {
                    sb.append('-');
                    length = 1;
                }
                sb.append(Character.toUpperCase(c));
            }
        }
        return sb.reverse().toString();
    }
}