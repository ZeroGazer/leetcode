class Solution {
    public int minMoves(int[] nums) {
        int min = Integer.MAX_VALUE, max = Integer.MIN_VALUE;
        for (int num : nums) {
            min = Math.min(min, num);
            max = Math.max(max, num);
        }
        if (min == max) {
            return 0;
        }
        int moves = 0;
        for (int num : nums) {
            moves += num - min;
        }
        return moves;
    }
}