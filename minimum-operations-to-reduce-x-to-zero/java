class Solution {
    public int minOperations(int[] nums, int x) {
        int n = nums.length, sum = 0;
        for (int num : nums) {
            sum += num;
        }
        if (sum < x) {
            return -1;
        } else if (sum == x) {
            return n;
        }
        int max = -1;
        for (int left = 0, right = 0, partialSum = 0; right < n; right++) {
            partialSum += nums[right];
            while (left <= right && partialSum > sum - x) {
                partialSum -= nums[left++];
            }
            if (partialSum == sum - x) {
                max = Math.max(max, right - left + 1);
            }
        }
        if (max == -1) {
            return -1;
        }
        return n - max;
    }
}