class Solution {
    public int totalNumbers(int[] digits) {
        int[] freqs = new int[10];
        for (int digit : digits) {
            freqs[digit]++;
        }
        int count = 0;
        for (int i = 1; i <= 9; i++) {
            if (freqs[i] == 0) {
                continue;
            }
            freqs[i]--;
            for (int j = 0; j <= 9; j++) {
                if (freqs[j] == 0) {
                    continue;
                }
                freqs[j]--;
                for (int k = 0; k < 9; k += 2) {
                    if (freqs[k] > 0) {
                        count++;
                    }
                }
                freqs[j]++;
            }
            freqs[i]++;
        }
        return count;
    }
}