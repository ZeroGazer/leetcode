class Solution {
    public boolean sumGame(String num) {
        int n = num.length();
        char[] arr = num.toCharArray();
        int[] half1 = count(arr, 0, n / 2 - 1), half2 = count(arr, n / 2, n - 1);
        return ((half1[0] + half2[0] & 1) == 1) || ((half2[0] - half1[0]) * 9 / 2) != (half1[1] - half2[1]);
    }

    private int[] count(char[] arr, int start, int end) {
        int wildcard = 0, sum = 0;
        for (int i = start; i <= end; i++) {
            char c = arr[i];
            if (c == '?') {
                wildcard++;
            } else {
                sum += c - '0';
            }
        }
        return new int[] {wildcard, sum};
    }
}