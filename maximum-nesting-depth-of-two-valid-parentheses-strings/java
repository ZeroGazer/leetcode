class Solution {
    public int[] maxDepthAfterSplit(String seq) {
        int n = seq.length(), depth = 0;
        int[] result = new int[n];
        for (int i = 0; i < n; i++) {
            char c = seq.charAt(i);
            if (c == '(') {
                result[i] = (depth++) & 1;
            } else {
                result[i] = (--depth) & 1;
            }
        }
        return result;
    }
}