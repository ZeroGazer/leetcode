class Solution {
    public int minOperations(String s) {
        int n = s.length();
        char min = 'z', max = 'a';
        boolean isSorted = true;
        for (int i = 0; i < n; i++) {
            char c = s.charAt(i);
            if (min > c) {
                min = c;
            }
            if (max < c) {
                max = c;
            }
            if (i != 0 && c < s.charAt(i - 1)) {
                isSorted = false;
            }
        }
        if (isSorted) {
            return 0;
        } else if (n == 2) {
            return -1;
        } else if (s.charAt(0) == min || s.charAt(n - 1) == max) {
            return 1;
        } else {
            for (int i = 1; i < n - 1; i++) {
                if (s.charAt(i) == min || s.charAt(i) == max) {
                    return 2;
                }
            }
            return 3;
        }
    }
}