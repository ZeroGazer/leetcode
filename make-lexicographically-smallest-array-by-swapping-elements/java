class Solution {
    public int[] lexicographicallySmallestArray(int[] nums, int limit) {
        int n = nums.length;
        int[] sortedNums = Arrays.copyOf(nums, n);
        Arrays.sort(sortedNums);
        Map<Integer, Integer> numToGroup = new HashMap<>();
        Map<Integer, Queue<Integer>> groupToSortedNum = new HashMap<>();
        for (int i = 0, groupIndex = 0; i < n; i++) {
            if (i != 0 && sortedNums[i] - sortedNums[i - 1] > limit) {
                groupIndex++;
            }
            numToGroup.put(sortedNums[i], groupIndex);
            groupToSortedNum.putIfAbsent(groupIndex, new LinkedList<>());
            groupToSortedNum.get(groupIndex).offer(sortedNums[i]);
        }
        for (int i = 0; i < n; i++) {
            nums[i] = groupToSortedNum.get(numToGroup.get(nums[i])).poll();
        }
        return nums;
    }
}