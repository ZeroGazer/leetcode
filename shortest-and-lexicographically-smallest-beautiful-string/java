class Solution {
    public String shortestBeautifulSubstring(String s, int k) {
        int n = s.length(), count = 0;
        String result = "";
        for (int left = 0, right = 0; right < n; right++) {
            if (s.charAt(right) == '1') {
                count++;
            }
            while (count > k || (left < right && s.charAt(left) == '0')) {
                if (s.charAt(left++) == '1') {
                    count--;
                }
            }
            if (count == k) {
                String candidate = s.substring(left, right + 1);
                if (result.equals("") || candidate.length() < result.length() || (candidate.length() == result.length() && result.compareTo(candidate) > 0)) {
                    result = candidate;
                }
            }
        }
        return result;
    }
}