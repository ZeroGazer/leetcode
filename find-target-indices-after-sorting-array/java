class Solution {
    public List<Integer> targetIndices(int[] nums, int target) {
        int n = nums.length, smaller = 0, larger = 0;
        for (int num : nums) {
            if (num < target) {
                smaller++;
            } else if (num > target) {
                larger++;
            }
        }
        List<Integer> result = new ArrayList<>();
        for (int i = smaller; i < n - larger; i++) {
            result.add(i);
        }
        return result;
    }
}